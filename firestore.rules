rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each player owns their own document tree under /players/{uid}
    // (active run, saved snapshots, profile). Owner-only access.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Global Head-to-Head pool: any signed-in player can READ all entries
    // (to be matched against), but may only create/update/delete entries that
    // they own (the doc's `uid` field must equal their auth uid). This enables
    // global async PvP without Cloud Functions / the Blaze plan.
    match /h2hPool/{snapId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Static public catalog data (read-only to clients).
    match /public/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /duels/{code} {
      allow get: if request.auth != null && request.auth.uid in resource.data.uids;
      match /rounds/{wave} {
        allow get: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/duels/$(code)).data.uids;
      }
    }

    match /swiftBoards/{board}/scores/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && board in ["standard", "singleFaction", "oneRoom", "weakened", "noTanks", "unitsOnly", "noUnits",
          "faction-goblinoid", "faction-undead", "faction-beast", "faction-demon", "faction-construct", "faction-aberration"]
        && request.resource.data.keys().hasOnly(["uid", "wave", "kills"])
        && request.resource.data.uid == uid
        && request.resource.data.wave is int && request.resource.data.wave > 0
        && request.resource.data.kills is int && request.resource.data.kills >= 0;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
